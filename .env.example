# Copy this file to .env and fill in your values
# cp .env.example .env

# LLM Provider: "demo" (no model), "ollama" (local), or "openai" (API key)
LLM_PROVIDER=ollama

# Ollama settings (install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# OpenAI settings (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Embedding model (runs locally, downloads on first use)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB storage path
CHROMA_PERSIST_DIR=./data/chroma_db

# Open Wiki markdown storage
WIKI_PAGES_DIR=./data/wiki/pages
WIKI_RAW_DIR=./data/wiki/raw

# Maximum reasoning/tool iterations per agent request
MAX_AGENT_STEPS=5
