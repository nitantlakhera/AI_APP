# Copy to medical_assistant/.env only to override medical data paths.
# Configure LLM_PROVIDER, Ollama, and OpenAI in the project-root .env because
# the medical app intentionally uses the root application's shared LLM object.

# Medical-specific paths (defaults work if unset)
# Relative paths are resolved from the medical_assistant folder.
# MEDICAL_CHROMA_PERSIST_DIR=./data/chroma_db
# MEDICAL_SAMPLE_DOCS_DIR=./data/sample_docs
