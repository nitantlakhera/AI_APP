# Copy to fine_tuning/.env

# Base model to fine-tune (small model recommended for learning / CPU)
BASE_MODEL=distilgpt2

# Training settings
# Relative paths are resolved from the fine_tuning folder.
OUTPUT_DIR=./outputs
DATASET_PATH=./data/sample_dataset.jsonl
NUM_EPOCHS=3
BATCH_SIZE=2
LEARNING_RATE=2e-4
MAX_SEQ_LENGTH=256

# LoRA settings
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05

# Device: "auto", "cpu", or "cuda"
DEVICE=auto
